# Neon connection string, passed into each sandbox
DATABASE_URL=

# Daytona: https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# Boat: `boat api-key create sandbox-test --preset ci`
BOAT_API_KEY=

# Vercel: an access token plus the team and project the sandboxes bill to.
# Leave these empty to use VERCEL_OIDC_TOKEN from `vercel link && vercel env pull` instead.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Optional overrides
# REPO_URL=https://github.com/SiebeBaree/cloud-sandbox-test.git
# HOLD_SECONDS=60
